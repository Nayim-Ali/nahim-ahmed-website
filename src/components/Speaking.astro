---
import { speaking } from '../content/content';
import TopicCard from './TopicCard.astro';
import Button from './Button.astro';
import VideoBand from './VideoBand.astro';
import { site } from '../content/site';
---

<section id="speaking" class="section section--dark speaking" aria-labelledby="speaking-title">
  <div class="wrap">
    <div class="speaking__top">
      <div class="speaking__head">
        <h2 id="speaking-title" class="speaking__title lines">
          <span>{speaking.heading}</span>
          <span class="speaking__sub">{speaking.sub}</span>
        </h2>
      </div>
      <div class="speaking__copy">
        {speaking.paragraphs.map((p, i) => <p class="reveal" style={`--d:${i * 90}ms`}>{p}</p>)}
        <div class="reveal" style="--d:300ms"><Button href="#book" variant="light">Book Nahim to speak</Button></div>
      </div>
    </div>

    <div class="speaking__figure reveal-img">
      <VideoBand
        video={site.speakingVideo.video}
        mobileVideo={site.speakingVideo.mobileVideo}
        poster={site.speakingVideo.poster}
        alt={site.speakingVideo.alt}
        label="Keynote speaking"
        href="#keynote"
      />
    </div>

    <h3 class="speaking__topics-title reveal">{speaking.topicsHeading}</h3>
    <div class="speaking__topics">
      {speaking.topics.map((t, i) => <TopicCard title={t.title} blurb={t.blurb} index={i} />)}
    </div>
  </div>
</section>

<style>
  .speaking__top { display: grid; gap: 2.5rem; margin-bottom: var(--section-sm); }
  .speaking__title { font-size: var(--t-2xl); max-width: 12ch; }
  .speaking__sub { display: block; font-size: 0.5em; color: var(--amber-soft); margin-top: 0.4em; font-weight: 500; letter-spacing: 0; }
  .speaking__copy { display: grid; gap: 1.25rem; align-content: end; color: rgba(247,243,236,0.85); }
  .speaking__copy p { max-width: 46ch; }
  .speaking__figure { margin: 0 0 var(--section-sm); }
  .speaking__img { aspect-ratio: 16 / 9; background: rgba(247,243,236,0.08); outline: 1.5px dashed rgba(247,243,236,0.35); outline-offset: -1.5px; }
  .speaking__img.has-img { background: none; outline: 0; }
  .speaking__topics-title { font-size: var(--t-lg); margin-bottom: 2rem; }
  .speaking__topics { display: grid; gap: 2rem; }
  @media (min-width: 640px) { .speaking__topics { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 900px) {
    .speaking__top { grid-template-columns: 7fr 5fr; gap: var(--gutter); }
  }
  @media (min-width: 1100px) { .speaking__topics { grid-template-columns: repeat(3, 1fr); column-gap: 3rem; row-gap: 3rem; } }
  .ph.speaking__img::after { color: rgba(247,243,236,0.75); font-size: var(--t-base); }
</style>
