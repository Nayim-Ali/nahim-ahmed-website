---
import { site } from '../content/site';
import { hero } from '../content/content';

const media = site.hero;
const words = hero.headline.trim().split(/\s+/);
const accent = words.length > 1 ? words.pop() : '';
const opening = words.length ? words.join(' ') : hero.headline;
const hasVideo = Boolean(media.videoDesktop || media.videoMobile || media.videoWebm);
---
<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__visual" aria-hidden="true">
    <div class="hero__poster" style={'background-image:url("' + media.poster + '")'}></div>
    {hasVideo && (
      <video class="hero__video" muted loop playsinline preload="none" poster={media.poster}
        data-hero-video data-src-desktop={media.videoDesktop}
        data-src-mobile={media.videoMobile || media.videoDesktop} data-src-webm={media.videoWebm}>
        {media.captions && <track kind="captions" src={media.captions} srclang="en" label="English" default />}
      </video>
    )}
    <div class="hero__shade"></div>
    <div class="hero__rings"></div>
  </div>

  <div class="hero__frame wrap">
    <div class="hero__topline">
      <span class="hero__eyebrow"><span class="hero__pulse"></span> A VOICE ROOTED IN REAL LIFE</span>
      <span class="hero__index">LONDON · BEYOND THE STAGE</span>
    </div>
    <div class="hero__main">
      <p class="hero__overline">DR NAHIM AHMED MBE <span aria-hidden="true">/</span> KEYNOTE SPEAKER</p>
      <h1 class="hero__title" id="hero-title">
        <span class="hero__opening">{opening}</span>
        {accent && <span class="hero__accent">{accent}</span>}
      </h1>
      <div class="hero__after">
        <div class="hero__intro">
          <span class="hero__rule" aria-hidden="true"></span>
          <p>{hero.descriptor}</p>
        </div>
        <div class="hero__actions">
          <a class="hero__action hero__action--primary" href={hero.primaryCta.href}>{hero.primaryCta.label}<span aria-hidden="true">↗</span></a>
          <a class="hero__action hero__action--text" href={hero.secondaryCta.href}>{hero.secondaryCta.label}<span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
    <div class="hero__foot">
      <a href="#journey" class="hero__scroll"><span class="hero__scroll-orb" aria-hidden="true">↓</span> <span>SCROLL TO ENTER THE STORY</span></a>
      <span class="hero__foot-note">PURPOSE ISN'T A SLOGAN. IT'S WHAT WE DO NEXT.</span>
    </div>
  </div>
</section>
<style>
.hero{position:relative;isolation:isolate;min-height:100svh;background:#101513;color:#f6f5f0;overflow:hidden;display:flex}
.hero__visual,.hero__poster,.hero__video,.hero__shade,.hero__rings{position:absolute;inset:0;width:100%;height:100%}
.hero__visual{overflow:hidden;pointer-events:none}
.hero__poster{background-position:center 43%;background-size:cover;transform:scale(1.05);animation:hero-poster 15s ease-out both}
.hero__video{object-fit:cover;opacity:0;transition:opacity 1.4s ease}
.hero.is-playing .hero__video{opacity:1}
.hero__shade{background:linear-gradient(90deg,rgba(10,14,12,.94) 0%,rgba(13,18,16,.79) 43%,rgba(15,19,17,.34) 100%),linear-gradient(0deg,rgba(7,11,9,.82) 0%,transparent 50%,rgba(7,11,9,.32) 100%)}
.hero__rings{inset:auto -14% -47% auto;width:75vw;height:75vw;border:1px solid rgba(218,207,111,.20);border-radius:50%;box-shadow:0 0 0 9vw rgba(218,207,111,.025),0 0 0 18vw rgba(218,207,111,.022)}
.hero__frame{position:relative;z-index:2;display:flex;flex-direction:column;justify-content:space-between;padding-top:clamp(7.2rem,13vh,10rem);padding-bottom:clamp(1.5rem,4vh,3rem);min-height:100svh;width:min(100% - var(--gutter)*2,var(--max))}
.hero__topline,.hero__foot{display:flex;align-items:center;justify-content:space-between;gap:1.5rem}
.hero__eyebrow,.hero__index,.hero__overline,.hero__foot-note,.hero__scroll{font-size:.73rem;font-weight:700;letter-spacing:.17em;line-height:1.4}
.hero__eyebrow{display:inline-flex;align-items:center;gap:.75rem;color:#efe9b1}
.hero__pulse{height:8px;width:8px;background:#d4c54a;border-radius:50%;box-shadow:0 0 0 6px rgba(212,197,74,.16)}
.hero__index{opacity:.6}
.hero__main{padding:3.5rem 0 3rem}
.hero__overline{display:flex;gap:1rem;align-items:center;margin-bottom:clamp(1.4rem,3.5vh,2.8rem);opacity:.83}
.hero__overline span{color:#d4c54a}
.hero__title{font-size:clamp(3.7rem,8.2vw,9.5rem);line-height:.87;letter-spacing:-.071em;font-weight:700;max-width:12ch;text-wrap:balance}
.hero__opening,.hero__accent{display:block}
.hero__accent{font-style:italic;color:#e0d16b;margin-top:.04em}
.hero__after{display:flex;justify-content:space-between;align-items:end;flex-wrap:wrap;gap:2.5rem;margin-top:clamp(2rem,5vh,4rem)}
.hero__intro{display:flex;align-items:start;gap:1rem;max-width:30rem}
.hero__rule{width:38px;flex:none;height:1px;background:#d4c54a;margin-top:.85rem}
.hero__intro p{font-size:clamp(1rem,1.25vw,1.3rem);color:#d8dbd5;line-height:1.5}
.hero__actions{display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap}
.hero__action{display:inline-flex;align-items:center;gap:1.8rem;text-decoration:none;font-weight:700;font-family:var(--display);font-size:clamp(.94rem,1.1vw,1.12rem);transition:transform .2s,background .2s,color .2s}
.hero__action:hover{transform:translateY(-3px)}
.hero__action--primary{padding:1.15rem 1.55rem;color:#171918;background:#d4c54a}
.hero__action--primary:hover{background:#e6d876}
.hero__action--text{padding:1rem .2rem;border-bottom:1px solid rgba(255,255,255,.65)}
.hero__action span{font-size:1.3em}
.hero__foot{border-top:1px solid rgba(246,245,240,.22);padding-top:1.4rem}
.hero__foot-note{opacity:.62}
.hero__scroll{display:flex;gap:.8rem;align-items:center;text-decoration:none}
.hero__scroll-orb{display:grid;place-items:center;width:37px;height:37px;border:1px solid rgba(246,245,240,.55);border-radius:50%;font-size:1.05rem;transition:transform .2s}
.hero__scroll:hover .hero__scroll-orb{transform:translateY(4px)}
.hero__topline,.hero__overline,.hero__after,.hero__title,.hero__foot{animation:hero-arrive .95s both cubic-bezier(.16,1,.3,1)}
.hero__overline{animation-delay:.12s}.hero__title{animation-delay:.23s}.hero__after{animation-delay:.43s}.hero__foot{animation-delay:.65s}
@keyframes hero-arrive{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
@keyframes hero-poster{from{transform:scale(1.09)}to{transform:scale(1.02)}}
@media(max-width:750px){
.hero__frame{padding-top:7.2rem;min-height:100svh}
.hero__index,.hero__foot-note{display:none}
.hero__main{padding:3rem 0}
.hero__title{font-size:clamp(3.5rem,14vw,6.2rem);max-width:11ch;letter-spacing:-.06em}
.hero__after{align-items:start;gap:1.5rem;margin-top:2rem}
.hero__actions{gap:1rem}
.hero__action--primary{padding:1rem 1.2rem}
.hero__shade{background:linear-gradient(90deg,rgba(10,14,12,.93),rgba(10,14,12,.57)),linear-gradient(0deg,rgba(7,11,9,.78),transparent 75%)}
.hero__rings{width:125vw;height:125vw}
}
@media(max-height:620px) and (min-width:751px){.hero__title{font-size:clamp(3.6rem,7vw,7rem)}.hero__main{padding:2rem 0}}
@media(prefers-reduced-motion:reduce){.hero__poster,.hero__topline,.hero__overline,.hero__after,.hero__title,.hero__foot{animation:none}}
</style>
<script>
const heroRoot=document.querySelector<HTMLElement>('[data-hero]');
const film=heroRoot?.querySelector<HTMLVideoElement>('[data-hero-video]');
if(heroRoot && film && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && !(navigator as any).connection?.saveData){
 const isMobile=window.matchMedia('(max-width: 768px)').matches;
 const mp4=isMobile?film.dataset.srcMobile:film.dataset.srcDesktop;
 if(film.dataset.srcWebm){const el=document.createElement('source');el.src=film.dataset.srcWebm;el.type='video/webm';film.appendChild(el);}
 if(mp4){const el=document.createElement('source');el.src=mp4;el.type='video/mp4';film.appendChild(el);}
 if(film.querySelector('source')){
  film.addEventListener('playing',()=>heroRoot.classList.add('is-playing'));
  film.addEventListener('error',()=>heroRoot.classList.remove('is-playing'));
  film.muted=true;film.load();
  window.addEventListener('load',()=>film.play().catch(()=>{}),{once:true});
  const obs=new IntersectionObserver(([entry])=>{if(entry.isIntersecting)film.play().catch(()=>{});else film.pause()},{threshold:.05});
  obs.observe(heroRoot);
 }
}
</script>
