---
import { site } from '../content/site';
import { hero } from '../content/content';

const video = site.hero;
const words = hero.headline.trim().split(/\s+/);
const lastWord = words.length > 1 ? words.pop() : '';
const mainWords = words.length ? words.join(' ') : hero.headline;
const hasVideo = Boolean(video.videoDesktop || video.videoMobile || video.videoWebm);
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__visual" aria-hidden="true">
    <div
      class="hero__poster"
      style={`background-image: url("${video.poster}"), url("/media/speaker-stage-placeholder.svg")`}
    ></div>
    {hasVideo && (
      <video
        class="hero__video"
        poster={video.poster}
        muted
        loop
        autoplay
        playsinline
        preload="metadata"
        data-hero-video
      >
        {video.videoMobile && <source src={video.videoMobile} media="(max-width: 740px)" type="video/mp4" />}
        {video.videoWebm && <source src={video.videoWebm} type="video/webm" />}
        {video.videoDesktop && <source src={video.videoDesktop} type="video/mp4" />}
        {video.captions && <track kind="captions" src={video.captions} srclang="en" label="English" default />}
      </video>
    )}
    <div class="hero__shade"></div>
  </div>

  <div class="wrap hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">DR NAHIM AHMED MBE <span aria-hidden="true">/</span> KEYNOTE SPEAKER</p>
      <h1 id="hero-title" class="hero__headline">
        <span>{mainWords}</span>
        {lastWord && <em>{lastWord}</em>}
      </h1>
      <p class="hero__subtitle">{hero.descriptor}</p>
      <div class="hero__actions">
        <a class="hero__cta" href={hero.primaryCta.href}>{hero.primaryCta.label}<span aria-hidden="true">↗</span></a>
        <a class="hero__secondary" href={hero.secondaryCta.href}>{hero.secondaryCta.label}<span aria-hidden="true">↗</span></a>
      </div>
    </div>
    {hasVideo && (
      <button type="button" class="hero__play" data-hero-play hidden aria-label="Play the background video">
        <span aria-hidden="true">▶</span> Play background video
      </button>
    )}
    <a class="hero__scroll" href="#journey" aria-label="Explore Nahim's story below">
      <span>EXPLORE HIS STORY</span><span aria-hidden="true">↓</span>
    </a>
  </div>
</section>

<style>
  .hero { position:relative; isolation:isolate; min-height:100svh; color:#fff; background:#111714; overflow:hidden; }
  .hero__visual,.hero__poster,.hero__video,.hero__shade { position:absolute; inset:0; width:100%; height:100%; }
  .hero__visual { pointer-events:none; overflow:hidden; }
  .hero__poster { background-size:cover,cover; background-position:center 42%; background-color:#19221e; }
  .hero__video { object-fit:cover; object-position:center center; opacity:1; }
  /* Keep the video visibly composited: Safari may decline autoplay on invisible video. */
  .hero__shade {
    background:
      linear-gradient(to bottom,rgba(10,15,13,.42) 0%,rgba(10,15,13,.02) 32%,rgba(10,15,13,.23) 56%,rgba(7,11,9,.79) 100%),
      linear-gradient(90deg,rgba(10,15,13,.18),transparent 60%);
  }
  .hero__inner { position:relative; z-index:1; min-height:100svh; display:flex; align-items:center; flex-direction:column; justify-content:flex-end; padding-top:8rem; padding-bottom:2rem; }
  .hero__copy { width:100%; display:flex; flex-direction:column; align-items:center; text-align:center; margin:auto 0 clamp(2.3rem,4.5vh,4.5rem); padding-top:clamp(11rem,31vh,24rem); }
  .hero__eyebrow { font-size:clamp(.72rem,1vw,.9rem); font-weight:700; letter-spacing:.19em; margin-bottom:clamp(1.1rem,2.5vh,2rem); color:rgba(255,255,255,.95); text-shadow:0 2px 16px #0009; }
  .hero__eyebrow span { color:#e0d16b; padding-inline:.6rem; }
  .hero__headline { max-width:1100px; font-size:clamp(3.2rem,6.3vw,7.6rem); line-height:.98; letter-spacing:-.06em; font-weight:700; text-shadow:0 2px 35px #0006; text-wrap:balance; }
  .hero__headline span { color:#fff; }
  .hero__headline em { color:#e2d46f; font-style:normal; white-space:nowrap; }
  .hero__subtitle { max-width:55ch; margin:clamp(1.1rem,2.8vh,2rem) 0 0; font-size:clamp(1rem,1.65vw,1.45rem); color:#f5f5ed; line-height:1.45; text-shadow:0 1px 12px #000; }
  .hero__actions { display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:clamp(.8rem,2vw,1.5rem); margin-top:clamp(1.5rem,3vh,2.6rem); }
  .hero__cta,.hero__secondary { display:inline-flex; align-items:center; justify-content:center; gap:1.7rem; text-decoration:none; font-family:var(--display); font-weight:700; font-size:clamp(.93rem,1.1vw,1.08rem); min-height:3.65rem; transition:transform .25s,background .25s; }
  .hero__cta { padding:1rem 1.5rem; color:#171918; background:#d4c54a; border:1px solid #d4c54a; }
  .hero__cta:hover { background:#e5d873; transform:translateY(-3px); }
  .hero__secondary { padding:1rem .5rem; border-bottom:1px solid #fff9; color:#fff; }
  .hero__secondary:hover { transform:translateY(-3px); }
  .hero__cta span,.hero__secondary span { font-size:1.3em; }
  .hero__play { position:absolute;right:0;bottom:5.8rem;z-index:4;display:inline-flex;align-items:center;gap:.7rem;border:1px solid #ffffff88;background:#111a16dc;color:#fff;border-radius:999px;padding:.77rem 1.15rem;font:600 .88rem var(--display);cursor:pointer;backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px); }
  .hero__play span{color:#e4d771}
  .hero__play:hover{background:#1b2b23}
  .hero__play[hidden]{display:none!important}
  .hero__scroll { width:100%; display:flex; justify-content:space-between; align-items:center; text-decoration:none; font-size:.72rem; letter-spacing:.17em; font-weight:700; color:#ffffffdc; border-top:1px solid #ffffff45; padding-top:1rem; }
  .hero__scroll span:last-child { font-size:1.3rem; }
  @media(max-width:740px){
    .hero__inner { padding-top:6.5rem; padding-bottom:1.4rem; }
    .hero__copy { padding-top:clamp(8rem,22vh,15rem); }
    .hero__headline { font-size:clamp(2.9rem,11.5vw,5.1rem); line-height:1; }
    .hero__eyebrow { font-size:.66rem; letter-spacing:.12em; }
    .hero__subtitle { max-width:31ch; }
    .hero__shade { background:linear-gradient(to bottom,#0a0f0d66 0%,transparent 28%,#0a0f0d33 47%,#060907db 100%); }
    .hero__actions { gap:.45rem; }
    .hero__cta,.hero__secondary { min-height:3.2rem; }
    .hero__cta { padding:.85rem 1rem; }
    .hero__play { bottom:5rem;right:.5rem;font-size:.8rem; }
  }
  @media(max-height:630px) and (min-width:741px){
    .hero__copy { padding-top:7rem; }
    .hero__headline { font-size:clamp(3.5rem,5vw,5.5rem); }
  }
  @media(prefers-reduced-motion:reduce){ .hero__video,.hero__cta,.hero__secondary { transition:none; } }
</style>

<script>
  const heroRoot = document.querySelector<HTMLElement>('[data-hero]');
  const player = heroRoot?.querySelector<HTMLVideoElement>('[data-hero-video]');
  const playButton = heroRoot?.querySelector<HTMLButtonElement>('[data-hero-play]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as any).connection?.saveData === true;

  if (heroRoot && player) {
    let manuallyStarted = false;
    let isInView = true;
    const setManualButton = (show: boolean) => {
      if (playButton) playButton.hidden = !show;
    };
    const startPlayback = () => {
      // Explicitly mute before requesting playback. iOS Safari needs muted + playsinline.
      player.muted = true;
      player.defaultMuted = true;
      const request = player.play();
      if (request && typeof request.catch === 'function') {
        request.catch(() => setManualButton(true));
      }
    };

    player.addEventListener('playing', () => {
      heroRoot.classList.add('is-playing');
      setManualButton(false);
    });
    player.addEventListener('pause', () => {
      heroRoot.classList.remove('is-playing');
      if (isInView && !document.hidden) setManualButton(true);
    });
    player.addEventListener('error', () => {
      heroRoot.classList.remove('is-playing');
      setManualButton(true);
    });

    // Low Power Mode on iPhone can reject autoplay. This click handler provides
    // a real user gesture, which Safari permits for playback.
    playButton?.addEventListener('click', () => {
      manuallyStarted = true;
      startPlayback();
    });

    if (reducedMotion || saveData) {
      // Respect motion/data preferences; visitors can still play on demand.
      player.autoplay = false;
      player.pause();
      setManualButton(true);
    } else {
      const begin = () => {
        if (isInView && !document.hidden && player.paused) startPlayback();
      };
      if (document.readyState === 'complete') begin();
      else window.addEventListener('load', begin, { once: true });
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        isInView = entry.isIntersecting;
        if (!isInView) player.pause();
        else if (!reducedMotion && !saveData || manuallyStarted) startPlayback();
      }, { threshold: 0.08 });
      observer.observe(heroRoot);
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) player.pause();
      else if (isInView && (!reducedMotion && !saveData || manuallyStarted)) startPlayback();
    });
  }
</script>
