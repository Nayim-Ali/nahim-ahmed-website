---
import { intro } from '../content/content';
---

<section id="intro" class="section intro" aria-labelledby="intro-title">
  <div class="wrap intro__grid">
    <h2 id="intro-title" class="intro__lead reveal">{intro.lead}</h2>
    <div class="intro__body">
      {intro.paragraphs.map((p, i) => <p class="reveal" style={`--d:${120 + i * 100}ms`}>{p}</p>)}
      <p class="intro__pull reveal" style="--d:400ms">{intro.pull}</p>
    </div>
  </div>
</section>

<style>
  .intro__grid { display: grid; gap: 2.5rem; }
  .intro__lead { font-size: var(--t-xl); max-width: 16ch; }
  .intro__body { display: grid; gap: 1.25rem; align-content: start; }
  .intro__body p { max-width: 52ch; }
  .intro__pull {
    margin-top: 1rem;
    padding-left: 1.25rem;
    border-left: 3px solid var(--amber);
    font-family: var(--display);
    font-size: var(--t-md);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  @media (min-width: 900px) {
    .intro__grid { grid-template-columns: 7fr 5fr; gap: var(--gutter); align-items: start; }
    .intro__body { padding-top: 0.6rem; }
  }
</style>
