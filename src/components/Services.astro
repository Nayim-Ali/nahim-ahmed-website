---
import { services } from '../content/content';
import TopicCard from './TopicCard.astro';
---
<section id="work-with" class="section section--cream services" aria-labelledby="services-title">
  <div class="wrap">
    <h2 id="services-title" class="services__title reveal">{services.heading}</h2>
    <div class="services__grid">
      {services.items.map((s, i) => <TopicCard title={s.title} blurb={s.blurb} index={i} />)}
    </div>
  </div>
</section>
<style>
  .services__title { font-size: var(--t-xl); margin-bottom: 3rem; max-width: 14ch; }
  .services__grid { display: grid; gap: 2rem; }
  @media (min-width: 640px) { .services__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .services__grid { grid-template-columns: repeat(5, 1fr); gap: 2rem; } }
</style>
