---
/**
 * MediaEmbed — click-to-load YouTube player (no iframe until the user asks for it).
 * Props: youtubeId, title, poster (optional; defaults to YouTube's thumbnail)
 */
interface Props { youtubeId: string; title: string; poster?: string; class?: string }
const { youtubeId, title, poster, class: cls = '' } = Astro.props;
const thumb = poster || `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`;
---
<div class:list={['embed', cls]} data-embed data-yt={youtubeId} data-title={title}>
  <button type="button" class="embed__btn" data-embed-play aria-label={`Play video: ${title}`}>
    <img src={thumb} alt="" loading="lazy" decoding="async" width="1280" height="720" />
    <span class="embed__play" aria-hidden="true"></span>
  </button>
</div>
<style>
  .embed { position: relative; aspect-ratio: 16 / 9; background: #2c2924; overflow: hidden; }
  .embed__btn { position: absolute; inset: 0; width: 100%; padding: 0; border: 0; background: none; cursor: pointer; display: block; }
  .embed__btn img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .embed__btn:hover img { transform: scale(1.03); }
  .embed__play {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: 5rem; height: 5rem; border-radius: 50%;
    background: var(--amber); display: grid; place-items: center;
    transition: transform 0.3s var(--ease), background 0.3s var(--ease);
  }
  .embed__play::after {
    content: ''; width: 0; height: 0; margin-left: 4px;
    border-left: 1.2rem solid var(--white); border-top: 0.75rem solid transparent; border-bottom: 0.75rem solid transparent;
  }
  .embed__btn:hover .embed__play { transform: translate(-50%, -50%) scale(1.08); background: var(--amber-deep); }
  .embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-embed]').forEach((el) => {
    el.querySelector('[data-embed-play]')?.addEventListener('click', () => {
      const id = el.dataset.yt;
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = el.dataset.title || 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.setAttribute('allowfullscreen', '');
      el.replaceChildren(iframe);
    });
  });
</script>
