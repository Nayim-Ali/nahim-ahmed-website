---
import { speaking } from '../content/content';
const topics = speaking.topics.filter((item)=>item.title && item.blurb).slice(0,7);
---
<section class="topic-explorer section" id="topics" aria-labelledby="topics-title">
 <div class="wrap topic-explorer__grid">
  <div class="topic-explorer__left">
   <p class="topic-explorer__eyebrow">03 / WHAT MOVES A ROOM?</p>
   <h2 id="topics-title">Different rooms.<br/><em>One real voice.</em></h2>
   <p>Every audience brings a different challenge. Explore the conversations Nahim can bring to yours.</p>
   <a href="/keynote-speaking/" class="topic-explorer__link">All speaking details <span aria-hidden="true">↗</span></a>
  </div>
  <div class="topic-explorer__list">
   {topics.map((topic,i)=>(
    <details class="topic-explorer__item" name="speaking-topics" open={i===0}>
     <summary><span class="topic-explorer__number">{String(i+1).padStart(2,'0')}</span><span class="topic-explorer__title">{topic.title}</span><span class="topic-explorer__plus" aria-hidden="true">+</span></summary>
     <div class="topic-explorer__answer"><p>{topic.blurb}</p><a href="/contact/">Enquire about this topic <span aria-hidden="true">↗</span></a></div>
    </details>
   ))}
  </div>
 </div>
</section>
<style>
.topic-explorer{background:#e9eadf;color:#171918}
.topic-explorer__grid{display:grid;grid-template-columns:1fr 1.2fr;gap:clamp(3rem,7vw,9rem)}
.topic-explorer__left{position:sticky;top:8rem;align-self:start}
.topic-explorer__eyebrow{font-size:.77rem;color:#776b16;letter-spacing:.17em;font-weight:700;margin-bottom:2rem}
.topic-explorer h2{font-size:clamp(2.9rem,5vw,6rem);letter-spacing:-.055em;line-height:1.04}
.topic-explorer h2 em{color:#9d8f24}
.topic-explorer__left>p:not(.topic-explorer__eyebrow){font-size:1.14rem;line-height:1.55;max-width:33ch;margin-top:2rem;color:#4c544a}
.topic-explorer__link{display:inline-flex;gap:2rem;align-items:center;margin-top:2.5rem;font-family:var(--display);font-weight:700;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:.5rem}
.topic-explorer__list{border-top:1px solid #9fa395}
.topic-explorer__item{border-bottom:1px solid #9fa395}
.topic-explorer__item summary{display:grid;grid-template-columns:2.6rem 1fr auto;gap:1rem;align-items:center;list-style:none;cursor:pointer;padding:clamp(1.3rem,2.5vw,2.3rem) .2rem}
.topic-explorer__item summary::-webkit-details-marker{display:none}
.topic-explorer__number{font-size:.85rem;letter-spacing:.05em;color:#857622}
.topic-explorer__title{font-family:var(--display);font-size:clamp(1.25rem,2vw,2.1rem);font-weight:700;letter-spacing:-.035em}
.topic-explorer__plus{display:grid;place-items:center;width:2rem;height:2rem;border:1px solid #899083;border-radius:50%;font-size:1.4rem;font-weight:400;transition:transform .2s,background .2s}
.topic-explorer__item[open] .topic-explorer__plus{transform:rotate(45deg);background:#d4c54a;border-color:#d4c54a}
.topic-explorer__item[open] .topic-explorer__title{color:#706317}
.topic-explorer__answer{padding:0 2rem 2rem 3.6rem}
.topic-explorer__answer p{line-height:1.6;color:#414a41;max-width:42ch}
.topic-explorer__answer a{display:inline-flex;gap:1.2rem;margin-top:1.3rem;color:#171918;font-weight:700;font-size:.94rem;text-decoration:underline;text-underline-offset:.3em}
@media(max-width:800px){.topic-explorer__grid{grid-template-columns:1fr}.topic-explorer__left{position:static}.topic-explorer__answer{padding-left:0}.topic-explorer__item summary{grid-template-columns:2rem 1fr auto}}
@media(prefers-reduced-motion:reduce){.topic-explorer__plus{transition:none}}
</style>
