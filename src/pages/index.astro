---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Credibility from '../components/Credibility.astro';
import Keynote from '../components/Keynote.astro';
import Testimonials from '../components/Testimonials.astro';
import FinalCta from '../components/FinalCta.astro';
import Button from '../components/Button.astro';
---
<Base>
  <Hero />
  <Intro />
  <section class="section home-paths">
    <div class="wrap">
      <p class="home-paths__eyebrow">DISCOVER NAHIM</p>
      <h2 class="home-paths__heading">More than a story.<br/>A reason to act.</h2>
      <div class="home-paths__grid">
        <a href="/about/" class="home-paths__card">
          <span class="home-paths__no">01 / HIS JOURNEY</span>
          <strong>Meet Nahim</strong>
          <span>Explore the people, experiences and community that shaped his purpose.</span>
          <span class="home-paths__arrow">Explore his story ↗</span>
        </a>
        <a href="/keynote-speaking/" class="home-paths__card">
          <span class="home-paths__no">02 / HIS MESSAGE</span>
          <strong>Keynote speaking</strong>
          <span>Talks on leadership, resilience, youth work and meaningful change.</span>
          <span class="home-paths__arrow">Explore keynotes ↗</span>
        </a>
        <a href="/resources/" class="home-paths__card">
          <span class="home-paths__no">03 / HIS VOICE</span>
          <strong>Resources & media</strong>
          <span>Interviews, ideas and conversations beyond the stage.</span>
          <span class="home-paths__arrow">Explore resources ↗</span>
        </a>
      </div>
    </div>
  </section>
  <Credibility />
  <section class="home-keynote">
    <div class="wrap home-keynote__heading">
      <div><p class="home-paths__eyebrow">ON STAGE</p><h2>Speaking that sparks a conversation.</h2></div>
      <Button href="/keynote-speaking/">All speaking topics ↗</Button>
    </div>
  </section>
  <Keynote />
  <Testimonials />
  <FinalCta />
</Base>
<style>
.home-paths{background:#f6f5f0}
.home-paths__eyebrow{font-size:.78rem;letter-spacing:.2em;color:#82751c;font-weight:700;margin-bottom:1rem}
.home-paths__heading{font-size:clamp(2.8rem,6vw,6rem);letter-spacing:-.045em;margin-bottom:3rem}
.home-paths__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
.home-paths__card{display:flex;flex-direction:column;gap:1.25rem;padding:clamp(1.5rem,3vw,3rem);border:1px solid #d5d5cc;color:#171918;text-decoration:none;min-height:21rem;transition:background .2s,transform .2s}
.home-paths__card:hover{background:#ecebd8;transform:translateY(-4px)}
.home-paths__card strong{font-family:var(--display);font-size:clamp(1.7rem,2.8vw,2.9rem);line-height:1.05}
.home-paths__card>span:nth-child(3){font-size:1rem;color:#555c55}
.home-paths__no{font-size:.72rem;letter-spacing:.13em;color:#82751c;font-weight:700}
.home-paths__arrow{margin-top:auto;font-size:.95rem;font-weight:700}
.home-keynote{background:#171918;color:#f6f5f0;padding:5rem 0 3rem}
.home-keynote__heading{display:flex;gap:2rem;align-items:end;justify-content:space-between}
.home-keynote h2{font-size:clamp(2.6rem,5vw,5rem);max-width:13ch}
@media(max-width:760px){.home-paths__grid{grid-template-columns:1fr}.home-paths__card{min-height:15rem}.home-keynote__heading{align-items:start;flex-direction:column}}
</style>
