import Thoughts from '../components/Thoughts.astro';
import FAQ from '../components/FAQ.astro';
import FinalCta from '../components/FinalCta.astro';
---
<Base title={pages.resources.seoTitle} description={pages.resources.seoDescription}>
  <PageHero page="resources" />
  <Media />
  <Thoughts />
  <FAQ />
  <FinalCta />
</Base>
